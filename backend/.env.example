# ============================================
# HubSabia Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# cp .env.example .env

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Secret (OBRIGATÓRIO — o backend recusa iniciar sem ele)
# Generate a strong random string: openssl rand -base64 32
JWT_SECRET=

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017/hubsabia
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/hubsabia
MONGODB_URI=mongodb://localhost:27017/hubsabia

# Google Gemini API (Geração de texto e embeddings) — usado quando o usuário não tem chave própria
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Groq API (LLMs Llama — chat) — opcional; usada quando o usuário não tem chave própria
# Get your API key at: https://console.groq.com/keys
GROQ_API_KEY=

# Anthropic Claude API — reservado (provider desabilitado) — opcional
ANTHROPIC_API_KEY=

# Frontend URL (for CORS)
# Development: http://localhost:5173
# Production: Your Vercel/Netlify frontend URL
FRONTEND_URL=http://localhost:5173

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads/

# Create-admin script (npm run create-admin)
# ADMIN_EMAIL=admin@hubsabia.com
# ADMIN_PASSWORD= (se vazio, uma senha aleatória é gerada e impressa)
